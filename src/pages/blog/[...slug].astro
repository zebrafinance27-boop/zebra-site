---
import Base from "../../layouts/Base.astro";
import LeadForm from "../../components/LeadForm.astro";
import CheckPromo from "../../components/CheckPromo.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d) => d.toLocaleDateString("he-IL", { year: "numeric", month: "long", day: "numeric" });
const pageUrl = new URL(`/blog/${post.slug}/`, Astro.site).toString();
// car articles point readers to the digital car-equity check (/check/)
const isCar = (post.data.categories || []).includes("car");

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "he-IL",
  image: new URL(post.data.cover || "/images/zebra.webp", Astro.site).toString(),
  author: { "@type": "Organization", name: "זברה" },
  publisher: {
    "@type": "Organization",
    name: "זברה",
    logo: { "@type": "ImageObject", url: new URL("/images/logo.png", Astro.site).toString() },
  },
};

// שאלות נפוצות: נשלפות אוטומטית מהחלק "## שאלות נפוצות..." במאמר (כל ### היא שאלה)
const plain = (s) => s.replace(/<[^>]+>/g, "").replace(/\*\*|__|\*/g, "").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/\s+/g, " ").trim();
const body = post.body.replace(/\r\n/g, "\n");
const faqBlock = body.match(/^## [^\n]*שאלות נפוצות[^\n]*\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
const faqs = faqBlock
  ? [...faqBlock[1].matchAll(/^### (.+)\n([\s\S]*?)(?=^### |(?![\s\S]))/gm)]
      .map((m) => ({ q: plain(m[1]), a: plain(m[2]) }))
      .filter((f) => f.q && f.a)
  : [];
const faqSchema = faqs.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title={post.data.seoTitle || `${post.data.title} | זברה`}
  description={post.data.description}
  image={post.data.cover || "/images/zebra.webp"}
  type="article"
  checkCta={isCar}
  mobileTab={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

  <article class="block">
    <div class="wrap">
      <header class="article-head">
        <a class="back-link" href="/blog/"><span aria-hidden="true">→</span> כל המאמרים</a>
        <div class="pc-date">{fmt(post.data.pubDate)}</div>
        <h1>{post.data.title}</h1>
      </header>
      {post.data.cover && (
        <div class="article-cover"><img src={post.data.cover} alt={post.data.title} /></div>
      )}
      <div class="prose article-body">
        <Content />
      </div>
    </div>
  </article>

  {isCar ? <CheckPromo /> : <LeadForm />}
</Base>

<style is:global>
  /* עיצוב רכיבים בתוך גוף המאמר */
  .article-body > p:first-child { font-size: 1.2rem; color: var(--ink); }
  .article-body h2 { scroll-margin-top: 90px; }

  /* קופסת דוגמה / תרחיש להמחשה */
  .article-body .ex-box {
    background: var(--tint); border: 1px solid #d9e6c9; border-radius: 16px;
    padding: 18px 22px 4px; margin: 20px 0 24px;
  }
  .article-body .ex-box > p:first-child { margin-bottom: 8px; }
  .article-body .ex-box > p:first-child strong { color: var(--green-darker); font-size: .95rem; }
  .article-body .ex-box p { font-size: 1.04rem; }
  .article-body .ex-box > h3:first-child { margin: 0 0 10px; font-size: 1.12rem; color: var(--green-darker); }

  /* טבלאות: גלילה אופקית במסך צר */
  .article-body .table-wrap {
    overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 18px 0 22px;
    border: 1px solid var(--line); border-radius: 14px; background: var(--paper);
  }
  .article-body table { width: 100%; min-width: 440px; border-collapse: collapse; font-size: 1rem; }
  .article-body th, .article-body td { padding: 12px 16px; text-align: start; vertical-align: top; line-height: 1.55; }
  .article-body thead th { background: var(--green-deep); color: #fff; font-weight: 700; white-space: nowrap; }
  .article-body tbody tr + tr td { border-top: 1px solid var(--line); }
  .article-body tbody tr:nth-child(even) td { background: #fafaf6; }
  .article-body tbody td:first-child { font-weight: 600; color: var(--ink); }
  .article-body td { color: #33403a; }
  .article-body .ex-box .table-wrap { margin: 14px 0 18px; }

  /* בלוק הנעה לפעולה */
  .article-body .article-cta {
    background: var(--paper); border: 1px solid var(--line); border-inline-start: 5px solid var(--green);
    border-radius: 18px; box-shadow: var(--shadow-sm); padding: 24px 26px; margin: 34px 0;
  }
  .article-body .article-cta p { font-size: 1.12rem; font-weight: 600; color: var(--ink); margin-bottom: 12px; }
  .article-body .article-cta strong { white-space: nowrap; }
  .article-body .cta-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .article-body .cta-btns a { text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .article-body .cta-btns .btn { color: #fff; }
  .article-body .cta-btns .btn-line { color: var(--green-darker); }

  /* רשימה ממוספרת */
  .article-body ol { list-style: none; counter-reset: step; margin: 0 0 18px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .article-body ol li { counter-increment: step; display: flex; align-items: flex-start; gap: 10px; font-size: 1.08rem; color: #33403a; }
  .article-body ol li::before { content: counter(step); flex: none; width: 24px; height: 24px; margin-top: 3px; border-radius: 50%; background: var(--green-deep); color: #fff; font-size: .82rem; font-weight: 700; display: grid; place-items: center; }

  /* שורת הבהרה */
  .article-body .article-note {
    font-size: .85rem; color: var(--muted); border-top: 1px solid var(--line);
    padding-top: 14px; margin-top: 36px; line-height: 1.6;
  }

  @media (max-width: 600px) {
    .article-body > p:first-child { font-size: 1.12rem; }
    .article-body .ex-box { padding: 14px 16px 2px; border-radius: 14px; }
    .article-body table { font-size: .95rem; }
    .article-body th, .article-body td { padding: 10px 12px; }
    .article-body .article-cta { padding: 18px 18px; }
    .article-body .article-cta p { font-size: 1.05rem; }
    .article-body .cta-btns { flex-direction: column; }
    .article-body .cta-btns a { width: 100%; }
  }
</style>

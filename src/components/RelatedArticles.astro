---
// מאמרים מהבלוג שקשורים לעמוד ההלוואה: רשימת קישורים נקייה.
// מציג עד 6 מאמרים אחרונים מהקטגוריה. אם אין מאמרים בקטגוריה, החלק לא מוצג.
import { getCollection } from "astro:content";

const { category, limit = 6 } = Astro.props;

const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.categories.includes(category))
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---
{posts.length > 0 && (
  <section class="rel-sec" aria-labelledby={`rel-${category}`}>
    <div class="wrap rel-wrap">
      <h2 class="rel-title" id={`rel-${category}`}>מאמרים<br />קשורים</h2>
      <span class="rel-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2" /></svg>
      </span>
      <ul class="rel-list">
        {posts.map((post) => (
          <li><a href={`/blog/${post.slug}/`}>{post.data.title}<span class="rel-arr" aria-hidden="true">‹</span></a></li>
        ))}
        <li class="rel-all"><a href={`/blog/?cat=${category}`}>לכל המאמרים בבלוג<span class="rel-arr" aria-hidden="true">‹</span></a></li>
      </ul>
    </div>
  </section>
)}

<style>
  .rel-sec { background: var(--paper); border-block: 1px solid var(--line); padding: 44px 0; margin-top: 28px; }
  .rel-wrap { max-width: 900px; display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 36px; }
  .rel-title { margin: 0; font-size: 2.6rem; font-weight: 900; line-height: 1.05; color: var(--green-darker); }
  .rel-ic { width: 104px; height: 104px; border-radius: 50%; background: var(--green-deep); display: grid; place-items: center; flex: none; }
  .rel-ic svg { width: 46px; height: 46px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .rel-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .rel-list a { display: inline-flex; align-items: center; gap: 8px; padding: 5px 0; font-weight: 600; font-size: 1.05rem; color: var(--ink); transition: color .15s; }
  .rel-list a:hover { color: var(--green-deep); text-decoration: underline; text-underline-offset: 4px; }
  .rel-list a:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; border-radius: 4px; }
  .rel-arr { color: var(--green-deep); font-weight: 800; font-size: 1.2rem; line-height: 1; transition: transform .15s; }
  .rel-list a:hover .rel-arr { transform: translateX(-3px); }
  .rel-all a { color: var(--green-deep); font-weight: 700; font-size: .98rem; margin-top: 4px; }
  @media (max-width: 720px) {
    .rel-sec { padding: 30px 0; margin-top: 18px; }
    .rel-wrap { grid-template-columns: auto 1fr; gap: 14px 18px; }
    .rel-ic { width: 64px; height: 64px; grid-row: 1; grid-column: 1; }
    .rel-ic svg { width: 30px; height: 30px; }
    .rel-title { font-size: 1.9rem; grid-row: 1; grid-column: 2; }
    .rel-list { grid-column: 1 / -1; }
    .rel-list li:not(.rel-all) { border-bottom: 1px solid var(--line); }
    .rel-list a { padding: 9px 0; font-size: 1rem; }
  }
</style>

---
// סימולטור הלוואה כנגד נכס — מוטמע בעמוד /loans/neged-nechas/.
// פתוח לשימוש בלי להשאיר פרטים. בסוף: שלב קצר להשארת פרטים → netlify/functions/submit-property-lead.mjs
// הנחות החישוב (מזברה): תקרת מימון 85% משווי הנכס כולל המשכנתא הקיימת, ריבית לסימולציה 4.8%,
// תקופה 10–40 שנה, הלוואה ₪200K–₪10M. לשנות כאן ובשרת יחד (submit-property-lead.mjs).
---
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans+Hebrew:wght@400;500;600;700&display=swap" rel="stylesheet" />

<section class="ps-sec" id="sim" aria-labelledby="psTitle">
  <div class="wrap ps-wrap">
    <header class="ps-head">
      <span class="ps-eyebrow"><i></i>סימולטור הלוואה כנגד נכס</span>
      <h2 id="psTitle">כמה אפשר לגייס על הנכס שלכם?</h2>
      <p>שנו את המספרים וראו מיד את תמונת המימון: כמה אפשר לבחון, איך זה נראה ביחס לשווי הנכס, ומה יהיה ההחזר החודשי. בלי להשאיר פרטים.</p>
    </header>

    <div class="ps-grid">
      <!-- inputs -->
      <div class="ps-mini" aria-hidden="true"><span>החזר חודשי משוער <b class="fig">₪<span id="psMiniM">0</span></b></span><span>מימון כולל <b class="fig" id="psMiniL">0%</b></span></div>
      <div class="ps-panel ps-inputs">
        <div class="ps-field" data-k="value">
          <div class="ps-lab"><span class="ps-no">01</span><label for="psValue">שווי הנכס המשוער</label></div>
          <div class="ps-money"><span>₪</span><input id="psValue" inputmode="numeric" autocomplete="off" /></div>
          <input class="ps-range" type="range" min="0" max="1000" aria-label="שווי הנכס" data-for="value" />
          <div class="ps-scale"><span data-min></span><span data-max></span></div>
        </div>
        <div class="ps-field" data-k="mortgage">
          <div class="ps-lab"><span class="ps-no">02</span><label for="psMortgage">יתרת המשכנתא הקיימת</label><small>אם אין, השאירו 0</small></div>
          <div class="ps-money"><span>₪</span><input id="psMortgage" inputmode="numeric" autocomplete="off" /></div>
          <input class="ps-range" type="range" min="0" max="1000" aria-label="יתרת המשכנתא" data-for="mortgage" />
          <div class="ps-scale"><span data-min></span><span data-max></span></div>
        </div>
        <div class="ps-field" data-k="amount">
          <div class="ps-lab"><span class="ps-no">03</span><label for="psAmount">סכום ההלוואה שתרצו לבחון</label></div>
          <div class="ps-money"><span>₪</span><input id="psAmount" inputmode="numeric" autocomplete="off" /></div>
          <input class="ps-range" type="range" min="0" max="1000" aria-label="סכום ההלוואה" data-for="amount" />
          <div class="ps-scale"><span data-min></span><span data-max></span></div>
        </div>
        <div class="ps-field" data-k="years">
          <div class="ps-lab"><span class="ps-no">04</span><label for="psYears">תקופת ההחזר</label></div>
          <div class="ps-years"><b id="psYearsOut">20</b> שנים</div>
          <input class="ps-range" id="psYears" type="range" min="10" max="40" step="1" aria-label="תקופת ההחזר בשנים" data-for="years" />
          <div class="ps-scale"><span>10</span><span>40</span></div>
        </div>
      </div>

      <!-- outputs -->
      <div class="ps-out">
        <div class="ps-panel ps-dark">
          <div class="ps-row"><span><em>A</em> תמונת המימון שלך</span><span>סימולציה</span></div>
          <div class="ps-big-lab">החזר חודשי משוער</div>
          <div class="ps-big"><span class="cur">₪</span><b id="psMonthly">0</b></div>
          <div class="ps-sub"><span id="psTermTxt"></span> · סה"כ החזר משוער <span class="fig">₪<span id="psTotal">0</span></span></div>

          <div class="ps-ltv">
            <div class="ps-ltv-top"><span>שיעור המימון הכולל מתוך שווי הנכס</span><b class="fig" id="psLtv">0%</b></div>
            <div class="ps-bar" aria-hidden="true">
              <i class="m" id="psBarM"></i><i class="n" id="psBarN"></i><i class="f" id="psBarF"></i>
              <span class="cap" title="תקרת 85%"></span>
            </div>
            <div class="ps-legend"><span><i class="m"></i>משכנתא קיימת</span><span><i class="n"></i>הלוואה חדשה</span><span><i class="f"></i>שווי פנוי</span><span class="capl">תקרה 85%</span></div>
          </div>
          <p class="ps-status" id="psStatus" role="status"></p>
        </div>

        <dl class="ps-stats">
          <div><dt>שווי פנוי בנכס</dt><dd class="fig">₪<span id="psEquity">0</span></dd></div>
          <div><dt>תקרת מימון משוערת</dt><dd class="fig">₪<span id="psMax">0</span></dd></div>
        </dl>

        <div class="ps-routes" role="radiogroup" aria-label="תקופת החזר לדוגמה">
          <button type="button" role="radio" data-years="40"><span>החזר חודשי נמוך</span><small>40 שנה</small><b class="fig">₪<span>0</span></b></button>
          <button type="button" role="radio" data-years="25"><span>מסלול מאוזן</span><small>25 שנה</small><b class="fig">₪<span>0</span></b></button>
          <button type="button" role="radio" data-years="15"><span>תקופה קצרה</span><small>15 שנה</small><b class="fig">₪<span>0</span></b></button>
        </div>

        <button type="button" class="ps-cta" id="psOpen">קבלו בדיקה אישית למספרים האלה <i aria-hidden="true">←</i></button>

        <!-- lead step -->
        <form class="ps-panel ps-lead" id="psLead" hidden novalidate>
          <div class="ps-lead-head"><b>נשלח את הנתונים לנציג זברה</b><span>נציג יחזור אליכם עם בדיקה מול גופי המימון. בלי תשלום מראש.</span></div>
          <div class="ps-in"><label for="psName">שם מלא</label><input id="psName" autocomplete="name" placeholder="ישראל ישראלי" /></div>
          <div class="ps-in2">
            <div class="ps-in"><label for="psPhone">טלפון נייד</label><input id="psPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="050-000-0000" dir="ltr" /></div>
            <div class="ps-in"><label for="psEmail">מייל</label><input id="psEmail" type="email" autocomplete="email" placeholder="name@gmail.com" dir="ltr" /></div>
          </div>
          <input class="ps-hp" id="psCompany" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="ps-consent"><input type="checkbox" id="psConsent" /><span>אני מאשר/ת לזברה לשמור ולהעביר את הפרטים לצורך בדיקת הבקשה ויצירת קשר בטלפון, ב-SMS, בוואטסאפ או במייל, בהתאם ל<a href="/privacy/" target="_blank" rel="noopener">מדיניות הפרטיות</a>.</span></label>
          <p class="ps-err" id="psErr" role="alert"></p>
          <button type="submit" class="ps-cta ps-send" id="psSend">שליחה לבדיקה אישית</button>
        </form>
        <div class="ps-panel ps-done" id="psDone" hidden>
          <b>הפרטים נשלחו. נציג זברה יחזור אליכם בהקדם.</b>
          <span>מספר פנייה <span class="fig" id="psRef"></span></span>
        </div>
      </div>
    </div>

    <details class="ps-how">
      <summary>איך חישבנו?</summary>
      <ul>
        <li>החזר חודשי לפי לוח שפיצר (החזר קבוע), בריבית שנתית משוערת של <b class="fig">4.8%</b> לצורך הסימולציה. הריבית בפועל נקבעת על ידי הגוף המממן.</li>
        <li>תקרת מימון משוערת: עד <b class="fig">85%</b> משווי הנכס, כולל המשכנתא הקיימת.</li>
        <li>הלוואה של <span class="fig">₪200,000</span> עד <span class="fig">₪10,000,000</span>, לתקופה של 10 עד 40 שנה.</li>
        <li>לא כולל עמלות, שמאות, ביטוחים או שכר טרחה.</li>
      </ul>
    </details>
    <p class="ps-legal">החישוב מוצג להמחשה בלבד ואינו הערכת שווי, בדיקת זכאות, הצעת מימון או אישור אשראי. הלוואה בשעבוד נכס כרוכה בסיכון לנכס במקרה של אי-עמידה בהחזרים. כל מימון ותנאיו כפופים לבדיקה ולאישור הגוף המממן.</p>
  </div>
</section>

<script is:inline>
(function () {
  var C = { cap: 0.85, rate: 0.048, minLoan: 200000, maxLoan: 10000000, value: [300000, 30000000], yMin: 10, yMax: 40 };
  var root = document.getElementById("sim"); if (!root) return;
  var DEMO = /^(localhost|127\.0\.0\.1)$/.test(location.hostname) || /\.netlify\.app$/.test(location.hostname);
  var nf = new Intl.NumberFormat("he-IL");
  var fmt = function (n) { return nf.format(Math.round(n || 0)); };
  var clamp = function (v, a, b) { return Math.min(b, Math.max(a, v)); };
  var round = function (v, s) { return Math.round(v / s) * s; };
  var $ = function (id) { return document.getElementById(id); };
  var pmt = function (P, years) { var r = C.rate / 12, n = years * 12; return P * r / (1 - Math.pow(1 + r, -n)); };

  var s = { value: 2000000, mortgage: 500000, amount: 600000, years: 20 };
  var ranges = {
    value: function () { return [C.value[0], C.value[1], 10000]; },
    mortgage: function () { return [0, Math.max(0, s.value), 10000]; },
    amount: function () { return [C.minLoan, C.maxLoan, 10000]; },
  };
  // quadratic slider scale so the common range gets most of the track
  var toPos = function (v, a, b) { return Math.round(Math.sqrt(clamp((v - a) / (b - a || 1), 0, 1)) * 1000); };
  var fromPos = function (p, a, b, st) { return clamp(round(a + (b - a) * Math.pow(p / 1000, 2), st), a, b); };
  var fill = function (el, pct) { el.style.background = "linear-gradient(to left,#17300A 0%,#17300A " + pct + "%,#E2E4DA " + pct + "%,#E2E4DA 100%)"; };

  function paintInputs() {
    ["value", "mortgage", "amount"].forEach(function (k) {
      var f = root.querySelector('[data-k="' + k + '"]'), r = ranges[k](), sl = f.querySelector(".ps-range"), inp = f.querySelector(".ps-money input");
      if (document.activeElement !== inp) inp.value = fmt(s[k]);
      sl.value = toPos(s[k], r[0], r[1]); fill(sl, sl.value / 10);
      f.querySelector("[data-min]").textContent = "₪" + fmt(r[0]);
      f.querySelector("[data-max]").textContent = "₪" + fmt(r[1]);
    });
    var y = $("psYears"); y.value = s.years; fill(y, (s.years - C.yMin) / (C.yMax - C.yMin) * 100); $("psYearsOut").textContent = s.years;
  }

  function calc() {
    var equity = Math.max(0, s.value - s.mortgage);
    var maxLoan = clamp(C.cap * s.value - s.mortgage, 0, C.maxLoan);
    var ltv = s.value ? (s.mortgage + s.amount) / s.value : 0;
    var monthly = pmt(s.amount, s.years);
    return { equity: equity, maxLoan: maxLoan, ltv: ltv, monthly: monthly, total: monthly * s.years * 12 };
  }

  function render() {
    var r = calc();
    paintInputs();
    $("psMonthly").textContent = fmt(r.monthly);
    $("psTotal").textContent = fmt(r.total);
    $("psTermTxt").textContent = s.years + " שנה (" + s.years * 12 + " תשלומים)";
    $("psLtv").textContent = Math.round(r.ltv * 100) + "%";
    $("psMiniM").textContent = fmt(r.monthly); $("psMiniL").textContent = Math.round(r.ltv * 100) + "%"; $("psMiniL").classList.toggle("over", r.ltv > C.cap);
    var m = clamp(s.mortgage / s.value, 0, 1), n = clamp(s.amount / s.value, 0, 1 - m);
    $("psBarM").style.width = m * 100 + "%"; $("psBarN").style.width = n * 100 + "%"; $("psBarF").style.width = Math.max(0, 1 - m - n) * 100 + "%";
    $("psBarN").classList.toggle("over", r.ltv > C.cap);
    $("psEquity").textContent = fmt(r.equity);
    $("psMax").textContent = fmt(r.maxLoan);
    var st = $("psStatus");
    if (r.maxLoan < C.minLoan) { st.className = "ps-status bad"; st.textContent = "לפי הנתונים, השווי הפנוי בנכס נמוך מהמינימום להלוואה. נשמח לבדוק איתכם גם פתרונות אחרים."; }
    else if (r.ltv > C.cap) { st.className = "ps-status warn"; st.textContent = "הסכום חורג מתקרת 85% משווי הנכס. התקרה המשוערת שלכם היא ₪" + fmt(r.maxLoan) + "."; }
    else { st.className = "ps-status ok"; st.textContent = "הסכום נמצא בתוך תקרת המימון המשוערת."; }
    root.querySelectorAll(".ps-routes button").forEach(function (b) {
      var y = +b.dataset.years; b.querySelector("b span").textContent = fmt(pmt(s.amount, y));
      b.setAttribute("aria-checked", String(y === s.years)); b.classList.toggle("on", y === s.years);
    });
  }

  // wiring
  ["value", "mortgage", "amount"].forEach(function (k) {
    var f = root.querySelector('[data-k="' + k + '"]'), sl = f.querySelector(".ps-range"), inp = f.querySelector(".ps-money input");
    sl.addEventListener("input", function () { var r = ranges[k](); s[k] = fromPos(+sl.value, r[0], r[1], r[2]); normalize(k); render(); });
    inp.addEventListener("input", function () { var d = inp.value.replace(/\D/g, "").slice(0, 9); inp.value = d ? fmt(+d) : ""; s[k] = +d || 0; render(); });
    inp.addEventListener("blur", function () { normalize(k); render(); });
  });
  $("psYears").addEventListener("input", function (e) { s.years = +e.target.value; render(); });
  root.querySelectorAll(".ps-routes button").forEach(function (b) { b.addEventListener("click", function () { s.years = +b.dataset.years; render(); }); });

  function normalize(k) {
    s.value = clamp(s.value || C.value[0], C.value[0], C.value[1]);
    s.mortgage = clamp(s.mortgage, 0, s.value);
    s.amount = clamp(s.amount || C.minLoan, C.minLoan, C.maxLoan);
  }

  // ---- lead step ----
  var form = $("psLead");
  $("psOpen").addEventListener("click", function () { form.hidden = false; $("psOpen").hidden = true; setTimeout(function () { $("psName").focus(); }, 60); });
  var cookie = function (n) { var m = document.cookie.match("(?:^|; )" + n + "=([^;]*)"); return m ? decodeURIComponent(m[1]) : ""; };
  var uuid = function () { return crypto.randomUUID ? crypto.randomUUID() : "id-" + Date.now().toString(36) + Math.random().toString(36).slice(2); };
  var qs = new URLSearchParams(location.search);
  var sending = false;

  form.addEventListener("submit", async function (e) {
    e.preventDefault(); if (sending) return;
    var name = $("psName").value.trim(), phone = $("psPhone").value.replace(/\D/g, "").replace(/^972/, "0"), email = $("psEmail").value.trim().toLowerCase();
    var err = !name || name.length < 2 ? "נא למלא שם מלא" : !/^05\d{8}$/.test(phone) ? "נא למלא מספר נייד תקין (10 ספרות, מתחיל ב-05)" : !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? "נא למלא כתובת מייל תקינה" : !$("psConsent").checked ? "יש לאשר את העברת הפרטים כדי להמשיך" : "";
    $("psErr").textContent = err; if (err) return;
    var leadId = uuid(), eventId = "lead-" + leadId;
    var payload = {
      lead_id: leadId, full_name: name, phone: phone, email: email, consent: true,
      consent_text: "אישור העברת פרטים לצורך בדיקת הבקשה ויצירת קשר, בהתאם למדיניות הפרטיות",
      property_value: s.value, existing_mortgage: s.mortgage, requested_amount: s.amount, term_years: s.years,
      utm_source: qs.get("utm_source") || "", utm_medium: qs.get("utm_medium") || "", utm_campaign: qs.get("utm_campaign") || "",
      utm_content: qs.get("utm_content") || "", utm_term: qs.get("utm_term") || "", fbclid: qs.get("fbclid") || "",
      landing_page: location.origin + location.pathname, referrer: document.referrer || "",
      meta: { event_id: eventId, fbp: cookie("_fbp"), fbc: cookie("_fbc"), event_source_url: location.href },
      company: $("psCompany").value,
    };
    sending = true; $("psSend").disabled = true; $("psSend").textContent = "שולחים…";
    try {
      var data;
      if (DEMO) { await new Promise(function (r) { setTimeout(r, 600); }); console.info("[demo] property lead (not sent)", payload); data = { ok: true, ref: "DEMO-" + leadId.slice(-6).toUpperCase() }; }
      else {
        var res = await fetch("/api/submit-property-lead", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.ok) throw new Error(data.error || "HTTP " + res.status);
      }
      if (!DEMO && window.fbq) window.fbq("track", "Lead", { content_name: "property_check" }, { eventID: eventId });
      form.hidden = true; $("psDone").hidden = false; $("psRef").textContent = data.ref || "";
    } catch (x) {
      console.error("property lead failed", x);
      $("psErr").innerHTML = 'לא הצלחנו לשלוח כרגע. אפשר לנסות שוב, או <a href="https://wa.me/972545995519" target="_blank" rel="noopener">לפנות אלינו בוואטסאפ</a>.';
    } finally { sending = false; $("psSend").disabled = false; $("psSend").textContent = "שליחה לבדיקה אישית"; }
  });

  render();
})();
</script>

<style>
  .ps-sec { padding: 72px 0; background: var(--cream); border-block: 1px solid var(--line); font-family: "IBM Plex Sans Hebrew", "Noto Sans Hebrew", sans-serif; scroll-margin-top: 80px; }
  .ps-sec .fig, .ps-big b, .ps-years b, .ps-money input, .ps-no, .ps-row em, .ps-scale { font-family: "IBM Plex Mono", ui-monospace, monospace; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .ps-head { max-width: 720px; margin-bottom: 30px; }
  .ps-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: .88rem; font-weight: 700; color: var(--green-deep); }
  .ps-eyebrow i { width: 8px; height: 8px; background: #8FD64A; box-shadow: 0 0 0 3px rgba(143,214,74,.3); }
  .ps-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.5rem); line-height: 1.15; margin: 10px 0 12px; font-weight: 700; }
  .ps-head p { font-size: 1.08rem; color: #33403a; line-height: 1.65; }

  .ps-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 24px; align-items: start; }
  .ps-panel { background: #fff; border: 1px solid #d9dccf; }
  .ps-inputs { padding: 6px 22px; }
  .ps-field { padding: 18px 0 16px; border-bottom: 1px solid var(--line); }
  .ps-field:last-child { border-bottom: 0; }
  .ps-lab { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ps-lab label { font-weight: 600; font-size: 1rem; }
  .ps-lab small { color: var(--muted); font-size: .8rem; }
  .ps-no { font-size: .78rem; color: var(--green-deep); }
  .ps-money { display: flex; align-items: center; gap: 8px; margin-top: 10px; border: 1.5px solid #cfd3c6; padding: 0 14px; height: 52px; background: #fff; transition: border-color .15s; }
  .ps-money:focus-within { border-color: #17300A; }
  .ps-money span { color: var(--muted); font-weight: 600; }
  .ps-money input { flex: 1; min-width: 0; border: 0; outline: 0; font-size: 1.25rem; font-weight: 600; direction: ltr; text-align: right; background: transparent; color: var(--ink); }
  .ps-years { margin-top: 8px; font-size: .95rem; color: var(--muted); }
  .ps-years b { font-size: 1.5rem; color: var(--ink); font-weight: 600; }
  .ps-sec input.ps-range { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 0; margin: 16px 0 6px; outline: 0; cursor: pointer; direction: rtl; background: #E2E4DA; }
  .ps-sec input.ps-range::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 28px; background: #fff; border: 2px solid #17300A; border-radius: 2px; box-shadow: none; transform: none; }

---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Partners from "../components/Partners.astro";
import Calculator from "../components/Calculator.astro";
import Testimonials from "../components/Testimonials.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "תוך כמה זמן מקבלים תשובה?", acceptedAnswer: { "@type": "Answer", text: "לרוב מקבלים תשובה ראשונית תוך דקות בודדות מרגע מילוי השאלון." } },
    { "@type": "Question", name: "מתי הכסף מגיע לחשבון?", acceptedAnswer: { "@type": "Answer", text: "זה תלוי במסלול ובגוף המממן. בהלוואה כנגד רכב הכסף מגיע לרוב תוך 24 שעות מרגע האישור והשלמת המסמכים; בשאר המסלולים לוח הזמנים משתנה, ונעדכן אתכם מראש." } },
    { "@type": "Question", name: "מהם תנאי ההחזר?", acceptedAnswer: { "@type": "Answer", text: "הפריסה נקבעת לפי המסלול והגוף המממן, ואנחנו מתאימים אותה לתקציב שלכם. בהלוואה כנגד רכב אפשר לפרוס עד 100 תשלומים." } },
    { "@type": "Question", name: "כמה עולה לבדוק התאמה?", acceptedAnswer: { "@type": "Answer", text: "בדיקת ההתאמה ללא עלות ובלי התחייבות. עובדים על בסיס הצלחה בלבד, בלי דמי פתיחת תיק ובלי עמלות מראש." } }
  ]
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

<section class="zh-hero">
  <div class="zh-bg" aria-hidden="true"><span class="zh-orb zh-orb1"></span><span class="zh-orb zh-orb2"></span><span class="zh-grid"></span></div>
  <div class="wrap zh-hero-grid">
    <div class="zh-hero-text reveal">
      <span class="zh-eyebrow">עובדים בשבילך, לא בשביל הבנק.</span>
      <h1><span class="zh-h1-a">עולם של אפשרויות מימון.</span> <span class="zh-h1-b">חברה אחת בצד שלכם.</span></h1>
      <p class="lede">עם כ-30 גופי מימון וליווי מקצועי, אנחנו עוזרים ללקוחות פרטיים ולבעלי עסקים למצוא פתרונות אשראי שמתאימים לצרכים שלהם.</p>
      <div class="hero-actions">
        <button class="btn" onclick="scrollToForm()">בדקו התאמה תוך 30 שניות</button>
        <a class="btn btn-line" id="heroCall" href="tel:0500000000">חייגו אלינו</a>
      </div>
      <div class="hero-trustline">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        ללא עלות ובלי התחייבות · עובדים על בסיס הצלחה בלבד
      </div>
    </div>

    <div class="zh-stage reveal" id="zhStage">
      <div class="zh-halo" aria-hidden="true"></div>
      <div class="zh-ring zh-ring1" aria-hidden="true"></div>
      <div class="zh-ring zh-ring2" aria-hidden="true"></div>
      <img class="zh-mascot" src="/images/zebra-mascot.webp" alt="הזברה של זברה מימון" width="820" height="1230" fetchpriority="high">
      <div class="zh-float zh-f1" data-depth="0.6"><span class="zh-dot"></span><b>עובדים בשבילך,</b> לא בשביל הבנק</div>
      <div class="zh-float zh-f2" data-depth="1"><span class="zh-ico">₪</span><span><b>בלי עמלה מראש</b><small>רק על בסיס הצלחה</small></span></div>
      <div class="zh-float zh-f3" data-depth="0.8"><span class="zh-ico">✓</span><span><b>בדיקה ללא עלות</b><small>ובלי התחייבות</small></span></div>
      <div class="zh-float zh-f4" data-depth="0.4"><span class="zh-ico">30</span><span><b>כ־30 גופי מימון</b><small>בבדיקה אחת</small></span></div>
    </div>
  </div>
</section>

<LeadForm />

<section class="zh-stats">
  <div class="wrap">
    <div class="zh-stats-grid">
      <div class="zh-stat bl reveal"><div class="big" data-to="3" data-suf="">3</div><p>שנים בשוק המימון</p></div>
      <div class="zh-stat bl reveal"><div class="big" data-to="30" data-suf="">30</div><p>גופי מימון בבדיקה אחת</p></div>
      <div class="zh-stat bl reveal"><div class="big" data-to="0" data-suf=" ₪">0 ₪</div><p>עמלה מראש, משלמים רק בהצלחה</p></div>
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">מה אנחנו עושים</span>
      <h2>מימון שמתאים בדיוק אליכם</h2>
      <p>מסלולים שונים, מטרה אחת: להביא לכם את הכסף בתנאים הכי נוחים, מהר.</p>
    </div>
    <div class="zh-cards">
      <a class="zh-card reveal" href="/loans/kol-matara/" data-tilt>
        <div class="zh-card-art"><span class="zh-card-glow"></span><img src="/images/zebra-any-purpose.webp" alt="" width="620" height="893" loading="lazy"></div>
        <h3>הלוואה לכל מטרה</h3>
        <p>שיפוץ, אירוע, לימודים, טיסה או איחוד הלוואות. אתם בוחרים את המטרה.</p>
        <span class="zh-more">לפרטים <i></i></span>
      </a>
      <a class="zh-card reveal" href="/loans/neged-rechev/" data-tilt>
        <div class="zh-card-art zh-wide"><span class="zh-card-glow"></span><img src="/images/zebra-car.webp" alt="" width="760" height="757" loading="lazy"></div>
        <h3>הלוואה כנגד הרכב</h3>
        <p>מימון לפי שווי הרכב. הרכב והמפתחות נשארים אצלכם, גם עם שעבוד חלקי קיים. לרוב הכסף בחשבון תוך 24 שעות, בפריסה של עד 100 תשלומים.</p>
        <span class="zh-more">לפרטים <i></i></span>
      </a>
      <a class="zh-card reveal" href="/loans/baaley-asakim/" data-tilt>
        <div class="zh-card-art"><span class="zh-card-glow"></span><img src="/images/zebra-business.webp" alt="" width="620" height="930" loading="lazy"></div>
        <h3>הלוואות לבעלי עסקים</h3>
        <p>הון חוזר, צמיחה או גישור על פערי תזרים, עם ליווי אישי לאורך כל הדרך.</p>
        <span class="zh-more">לפרטים <i></i></span>
      </a>
    </div>
  </div>
</section>

<section class="block zh-videos">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">לקוחות מספרים</span>
      <h2>שמעו את זה מהם</h2>
      <p>לקוחות אמיתיים מספרים איך זה נראה אצלם.</p>
    </div>
    <div class="zh-vids">
      <figure class="zh-vid reveal">
        <blockquote>״ההחזר החודשי ירד ביותר מחצי״</blockquote>
        <button class="zh-vid-frame" type="button" data-src="/videos/testimonial-miri.mp4" aria-label="הפעלת הסרטון של מירי">
          <img src="/videos/testimonial-miri.jpg" alt="מירי מספרת על התהליך" width="540" height="960" loading="lazy">
          <span class="zh-play" aria-hidden="true"><i></i></span>
        </button>
        <figcaption>מירי</figcaption>
      </figure>
      <figure class="zh-vid reveal">
        <blockquote>״נתן לנו אפשרות לנשום״</blockquote>
        <button class="zh-vid-frame" type="button" data-src="/videos/testimonial-aviel.mp4" aria-label="הפעלת הסרטון של אביאל">
          <img src="/videos/testimonial-aviel.jpg" alt="אביאל מספר על התהליך" width="540" height="960" loading="lazy">
          <span class="zh-play" aria-hidden="true"><i></i></span>
        </button>
        <figcaption>אביאל</figcaption>
      </figure>
      <figure class="zh-vid reveal">
        <blockquote>״הוא עזר לי למלא את כל הטפסים ובא איתי לבנק״</blockquote>
        <button class="zh-vid-frame" type="button" data-src="/videos/testimonial-maya.mp4" aria-label="הפעלת הסרטון של מאיה">
          <img src="/videos/testimonial-maya.jpg" alt="מאיה מספרת על התהליך" width="540" height="960" loading="lazy">
          <span class="zh-play" aria-hidden="true"><i></i></span>
        </button>
        <figcaption>מאיה</figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
document.querySelectorAll(".zh-vid-frame").forEach(function(b){
  b.addEventListener("click",function(){
    document.querySelectorAll(".zh-vids video").forEach(function(v){v.pause();});
    var v=document.createElement("video");
    v.src=b.dataset.src; v.controls=true; v.autoplay=true; v.playsInline=true; v.setAttribute("playsinline","");
    v.poster=b.querySelector("img").src;
    b.replaceWith(v); v.play().catch(function(){});
  });
});
</script>

<section class="block">
  <div class="wrap">
    <div class="advocate reveal">
      <span class="eyebrow">למה זברה</span>
      <h2>אנחנו עובדים בשבילכם, לא בשביל הבנק</h2>
      <p>זברה היא לא חברת מימון. אנחנו מתווכים בינך לבין המלווים ועובדים עבורך: משווים, מתמקחים ומשיגים לך את ההלוואה המשתלמת ביותר.</p>
      <div class="adv-chips">
        <span><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>מתווכים, לא מלווים</span>
        <span><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>על בסיס הצלחה בלבד</span>
        <span><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>בלי דמי פתיחת תיק או עמלות מראש</span>
      </div>
    </div>
  </div>
</section>

<section class="block zh-how">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">איך זה עובד</span>
      <h2>ארבעה צעדים לכסף בחשבון</h2>
    </div>
    <div class="zh-steps" id="zhSteps">
      <div class="zh-line" aria-hidden="true"><i id="zhLineFill"></i></div>
      <div class="zh-step reveal"><div class="zh-num">1</div><h3>ממלאים פרטים</h3><p>שאלון קצר של פחות מדקה, הכל אונליין.</p></div>
      <div class="zh-step reveal"><div class="zh-num">2</div><h3>אנחנו בודקים</h3><p>משווים בשבילכם מול כ־30 גופי מימון.</p></div>
      <div class="zh-step reveal"><div class="zh-num">3</div><h3>מקבלים הצעה</h3><p>הצעה מותאמת אישית, ברורה ושקופה.</p></div>
      <div class="zh-step reveal"><div class="zh-num">4</div><h3>הכסף בחשבון</h3><p>הכסף מועבר ישירות לחשבון שלכם, בפריסה שמתאימה לכם.</p></div>
    </div>
  </div>
</section>

<Partners />

<Calculator />


<section class="block" style="background:var(--paper);border-block:1px solid var(--line)">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">שאלות נפוצות</span>
      <h2>כל מה שרציתם לדעת</h2>
    </div>
    <div class="faq reveal">
      <details class="faq-item"><summary>תוך כמה זמן מקבלים תשובה?<span class="fq-ic"></span></summary><div class="faq-a">לרוב מקבלים תשובה ראשונית תוך דקות בודדות מרגע מילוי השאלון. נציג חוזר אליכם עם הצעה מותאמת בהקדם.</div></details>
      <details class="faq-item"><summary>מתי הכסף מגיע לחשבון?<span class="fq-ic"></span></summary><div class="faq-a">זה תלוי במסלול ובגוף המממן. בהלוואה כנגד רכב הכסף מגיע לרוב תוך 24 שעות מרגע האישור והשלמת המסמכים; בשאר המסלולים לוח הזמנים משתנה, ונעדכן אתכם מראש.</div></details>
      <details class="faq-item"><summary>מהם תנאי ההחזר?<span class="fq-ic"></span></summary><div class="faq-a">הפריסה נקבעת לפי המסלול והגוף המממן, ואנחנו מתאימים אותה לתקציב שלכם. בהלוואה כנגד רכב אפשר לפרוס עד 100 תשלומים.</div></details>
      <details class="faq-item"><summary>מה זה "הלוואה כנגד הרכב"?<span class="fq-ic"></span></summary><div class="faq-a">מקבלים מימון על בסיס שווי הרכב שבבעלותכם — בלי למסור את הרכב או את המפתחות, וממשיכים להשתמש בו כרגיל.</div></details>
      <details class="faq-item"><summary>כמה עולה לבדוק התאמה?<span class="fq-ic"></span></summary><div class="faq-a">בדיקת ההתאמה ללא עלות ובלי התחייבות. אנחנו עובדים על בסיס הצלחה בלבד — בלי דמי פתיחת תיק ובלי עמלות מראש.</div></details>
    </div>
  </div>
</section>

<Testimonials />

<section class="block zh-final">
  <div class="wrap">
    <div class="zh-final-card reveal">
      <div class="zh-final-text">
        <h2>מוכנים להתחיל?</h2>
        <p>בדקו התאמה תוך 30 שניות, ונחזור אליכם עם ההצעה המתאימה לכם. בלי עלות ובלי התחייבות.</p>
        <button class="btn zh-btn-light" onclick="scrollToForm()">לבדיקת התאמה</button>
      </div>
      <img class="zh-final-mascot" src="/images/zebra-mascot.webp" alt="" width="820" height="1230" loading="lazy">
    </div>
  </div>
</section>

<script is:inline>
(function(){
  var reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var fine=window.matchMedia("(pointer: fine)").matches;
  /* parallax for the floating hero cards */
  var stage=document.getElementById("zhStage");
  var floats=stage?stage.querySelectorAll("[data-depth]"):[];
  var mx=0,my=0,ticking=false;
  function paint(){
    ticking=false;
    var sy=Math.min(window.scrollY,700);
    floats.forEach(function(el){
      var d=+el.dataset.depth;
      el.style.transform="translate3d("+(mx*14*d)+"px,"+(my*14*d-sy*0.12*d)+"px,0)";
    });
  }
  function req(){if(!ticking){ticking=true;requestAnimationFrame(paint);}}
  if(!reduce&&stage){
    window.addEventListener("scroll",req,{passive:true});
    if(fine){stage.addEventListener("mousemove",function(e){var r=stage.getBoundingClientRect();mx=(e.clientX-r.left)/r.width-.5;my=(e.clientY-r.top)/r.height-.5;req();});
      stage.addEventListener("mouseleave",function(){mx=0;my=0;req();});}
  }
  /* 3D tilt on service cards */
  if(!reduce&&fine){
    document.querySelectorAll("[data-tilt]").forEach(function(card){
      card.addEventListener("mousemove",function(e){var r=card.getBoundingClientRect();var x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
        card.style.transform="perspective(900px) rotateY("+(x*10)+"deg) rotateX("+(-y*10)+"deg) translateY(-6px)";
        card.style.setProperty("--gx",(x+.5)*100+"%");card.style.setProperty("--gy",(y+.5)*100+"%");});
      card.addEventListener("mouseleave",function(){card.style.transform="";});
    });
  }
  /* "how it works" line fills while scrolling */
  var steps=document.getElementById("zhSteps"),fill=document.getElementById("zhLineFill");
  function line(){
    if(!steps||!fill)return;
    var r=steps.getBoundingClientRect(),vh=window.innerHeight;
    var k=Math.max(0,Math.min(1,(vh*0.85-r.top)/(r.height+vh*0.35)));
    fill.style.transform="scaleX("+k+")";fill.parentNode.style.setProperty("--k",k);
    steps.querySelectorAll(".zh-step").forEach(function(s,i,all){s.classList.toggle("on",k>=(i+0.5)/all.length-0.05);});
  }
  if(reduce){if(fill)fill.style.transform="scaleX(1)";steps&&steps.querySelectorAll(".zh-step").forEach(function(s){s.classList.add("on");});}
  else{window.addEventListener("scroll",function(){requestAnimationFrame(line);},{passive:true});window.addEventListener("resize",line);line();}
})();
</script>
</Base>

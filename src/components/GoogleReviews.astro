---
import { googleReviews, GOOGLE_REVIEW_URL, GOOGLE_PROFILE_URL } from "../data/googleReviews";

interface Props { all?: boolean }
const { all = false } = Astro.props;
const items = all ? googleReviews : googleReviews.filter((r) => r.home).slice(0, 6);
---
<section class={all ? "block g-reviews g-reviews-all" : "block g-reviews"}>
  <div class="wrap">
    {!all && (
      <div class="sec-head center reveal">
        <h2>מה הלקוחות כותבים עלינו בגוגל</h2>
      </div>
    )}
    <div class="g-badge reveal">
      <svg class="g-logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.2l7.9 6.2C12.5 13.6 17.8 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.4-4.1 7-10.1 7-17.6z"/><path fill="#FBBC05" d="M10.6 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C1 16.6 0 20.2 0 24s1 7.4 2.7 10.8l7.9-6.2z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.2 0-11.5-4.1-13.4-9.9l-7.9 6.2C6.6 42.6 14.6 48 24 48z"/></svg>
      <span class="g-stars" aria-hidden="true">★★★★★</span>
      <span>ביקורות אמיתיות מלקוחות בגוגל</span>
    </div>
    <div class="g-actions">
      <a class="btn" href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener">כתבו לנו המלצה בגוגל</a>
      {all
        ? <a class="btn btn-line" href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener">לכל הביקורות בגוגל</a>
        : <a class="btn btn-line" href="/reviews/">לכל ההמלצות</a>}
    </div>

    {all ? (
      <div class="quotes quotes-grid">
        {items.map((r) => (
          <div class="quote reveal">
            <div class="stars" aria-label={`${r.rating} כוכבים`}>{"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}</div>
            <div class="q-body">{r.text.map((p) => <p>{p}</p>)}</div>
            <div class="who">{r.name}<span>ביקורת בגוגל</span></div>
          </div>
        ))}
      </div>
    ) : (
      <div class="g-carousel">
        <button class="g-arrow g-prev" type="button" aria-label="לביקורות הקודמות">›</button>
        <div class="g-track" tabindex="0" aria-label="ביקורות מגוגל — גוללים הצידה לעוד">
          {items.map((r) => (
            <div class="quote g-slide">
              <div class="stars" aria-label={`${r.rating} כוכבים`}>{"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}</div>
              <div class="q-body">{r.text.map((p) => <p>{p}</p>)}</div>
              <div class="who">{r.name}<span>ביקורת בגוגל</span></div>
            </div>
          ))}
        </div>
        <button class="g-arrow g-next" type="button" aria-label="לביקורות הבאות">‹</button>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".g-carousel").forEach((c) => {
    const track = c.querySelector<HTMLElement>(".g-track");
    if (!track) return;
    const step = () => {
      const s = track.querySelector<HTMLElement>(".g-slide");
      return s ? s.offsetWidth + 20 : track.clientWidth;
    };
    // RTL: גלילה שמאלה = ערך שלילי
    c.querySelector(".g-next")?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    c.querySelector(".g-prev")?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));

    // גרירה עם העכבר (במגע — גלילה טבעית של הדפדפן)
    let down = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      down = true; moved = false; startX = e.clientX; startScroll = track.scrollLeft;
      track.classList.add("dragging");
    });
    window.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startScroll - dx;
    });
    window.addEventListener("pointerup", () => {
      if (!down) return;
      down = false; track.classList.remove("dragging");
    });
    track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  });
</script>
